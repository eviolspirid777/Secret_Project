<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>f0f22361-bdbf-406f-b2df-32d0dc36d65a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.76.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.5" />
    <PackageReference Include="NSwag.Annotations" Version="14.6.3" />
    <PackageReference Include="NSwag.Core" Version="14.6.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.1.5" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\AuthService.proto" GrpcServices="Client">
      <SourceUri>http://localhost:8081/repository/proto-hosted/Authentication/AuthService.proto</SourceUri>
    </Protobuf>
    <Protobuf Include="Protos\ChannelService.proto" GrpcServices="Client">
      <SourceUri>http://localhost:8081/repository/proto-hosted/Channels/ChannelService.proto</SourceUri>
    </Protobuf>
  </ItemGroup>

  <ItemGroup Condition="'$(CodexBuild)' == 'true'">
    <Compile Remove="obj\Debug\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="ProgramServicesExtensions\Swagger\" />
  </ItemGroup>

</Project>
